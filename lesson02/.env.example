# Скопируйте в .env и заполните.

# --- Вариант 1: OpenRouter ---
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-...
# Модель обязана поддерживать tool calling.
# Модель по умолчанию будет зафиксирована после smoke-теста.
LLM_MODEL=openai/gpt-4o-mini

# --- Вариант 2: Ollama (локально, без ключа) ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_MODEL=qwen2.5:7b
